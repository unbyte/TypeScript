>match : Symbol(string.match)
>Skip : Symbol(Skip, Decl(typeFunctionCalculator.ts, 0, 79))
>After : Symbol(After, Decl(typeFunctionCalculator.ts, 21, 24))

                case ["hit", ")", infer End] { return [Value, End]; }
