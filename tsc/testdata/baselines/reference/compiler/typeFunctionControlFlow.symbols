>lessThan : Symbol(number.lessThan)
>Remaining : Symbol(Remaining, Decl(typeFunctionControlFlow.ts, 10, 8))

        Remaining = number.subtract<Remaining, 1>;
>number : Symbol(number)
>subtract : Symbol(number.subtract)
>Remaining : Symbol(Remaining, Decl(typeFunctionControlFlow.ts, 10, 8))
    }
    return Remaining;
>Remaining : Symbol(Remaining, Decl(typeFunctionControlFlow.ts, 10, 8))
}

