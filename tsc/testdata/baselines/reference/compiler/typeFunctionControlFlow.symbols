typefn Countdown<N> {
>Countdown : Symbol(Countdown, Decl(typeFunctionControlFlow.ts, 7, 1))
>N : Symbol(N, Decl(typeFunctionControlFlow.ts, 9, 17))

    type Remaining = N;
>Remaining : Symbol(Remaining, Decl(typeFunctionControlFlow.ts, 10, 8))
>N : Symbol(N, Decl(typeFunctionControlFlow.ts, 9, 17))

    while (number.lessThan<0, Remaining>) {
