    return fn.compose<{
>fn : any

        members: {}; constructs: []; calls: [{
>members : {}
>constructs : []
>calls : [{ typeParameters: [{ key: "destination"; name: "New"; }]; parameters: [{ type: New; }]; result: Result; }]

            typeParameters: [{key: "destination"; name: "New"}];
>typeParameters : [{ key: "destination"; name: "New"; }]
>key : "destination"
>name : "New"

            parameters: [{type: New}]; result: Result;
>parameters : [{ type: New; }]
>type : New
>result : Result

        }];
    }>;
}
