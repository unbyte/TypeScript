// R2 specification examples; expected outcomes, not executed compiler tests.

typefn Less<A, B> { return A < B; }
typefn Min<A, B> {
  if (A < B) { return A; }
  return B;
}
typefn Clamp<Value, Low, High> {
  if (Low > High) { fail<"Lower bound exceeds upper bound">; }
  if (Value < Low) { return Low; }
  if (Value > High) { return High; }
  return Value;
}
typefn Below<Values, Limit> {
  type result = never;
  for (type value in Values) {
    if (value < Limit) { result = result | value; }
  }
  return result;
}
typefn Add<A, B> { return A + B; }

// Half-open safe-integer number range; descending/empty ranges yield never.
typefn Range<Start, Stop> {
  if (!numeric.isSafeInteger<Start> || !numeric.isSafeInteger<Stop>) {
    fail<"Range endpoints must be safe integers">;
  }
  type result = never;
  type value = Start;
  while (value < Stop) {
    result = result | value;
    value = value + 1;
  }
  return result;
}

type A = Less<-3, 2>; // true
type B = Min<3.5, 2.25>; // 2.25
type C = Clamp<120, 0, 100>; // 100
type D = Below<2 | 8 | 15, 10>; // 2 | 8
type E = Add<17, 25>; // 42
type F = Range<0, 4>; // 0 | 1 | 2 | 3
type G = Less<9007199254740992n, 9007199254740993n>; // true
// Less<1 | 2, 3>, Less<number, 3>, Less<1, 2n>: scalar-domain diagnostics.
